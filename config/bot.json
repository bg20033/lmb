{
  // Shown to the news sites in every request. Put a real contact address here.
  "UserAgent": "LajmeBot/1.0 (+mailto:redaksia@example.com)",
  "RequestTimeoutSeconds": 25,
  "MinDelayPerHostMs": 1500,
  "RespectRobotsTxt": false,

  // How much to publish on every run (the GitHub workflow runs every 2 hours by default).
  "MaxStoriesPerRun": 2,      // new stories written per run (free models: max ~50 AI requests/day)
  "SitesPerStory": 2,         // how many sites get their own version of each story
  "MaxSourcesPerStory": 4,
  "MaxStoryAgeHours": 10,
  "ClusterSimilarity": 0.3,
  "FeaturedMinSources": 3,
  "StateRetentionDays": 10,

  "Ai": {
    // "openrouter" = one key for hundreds of models (https://openrouter.ai/models)
    // "anthropic"  = Claude directly (then Model e.g. "claude-sonnet-5", secret ANTHROPIC_API_KEY)
    "Provider": "openrouter",

    // FREE models (":free"): $0, but OpenRouter allows only 20 requests/minute and 50 requests/day
    // (1000/day once you have bought at least $10 of credits). One article = 1 request.
    // If you get "No endpoints found matching your data policy", enable free models at
    // https://openrouter.ai/settings/privacy
    //
    // Paid, better Albanian (price per million tokens, input / output, September 2026):
    //   google/gemini-3.8-flash        $0.75 / $3.75   ~1 cent per article
    //   deepseek/deepseek-v4.1-flash   $0.035 / $0.29  ~0.1 cent per article
    // Try a model first with the workflow's "dry-run" mode and the "model" field.
    "Model": "google/gemma-4-31b-it:free",
    // Used automatically if the main model is busy or down ("openrouter/free" = any free model).
    "FallbackModels": ["qwen/qwen3.8-27b:free", "openrouter/free"],

    // "text" works with every model (free ones write longer articles this way); "tools" = function calling.
    "OutputFormat": "text",
    // Free endpoints occasionally accept a request but never start generating. Keep each
    // attempt short so the fallback model (or the next story) gets a chance in this run.
    "RequestTimeoutSeconds": 60,
    // A 350–600 word Albanian article fits comfortably here. A much larger limit lets
    // free models ramble until OpenRouter ends the answer with finish_reason=length.
    "MaxTokens": 3200,
    "MinWords": 350,
    "MaxWords": 600
  },

  // Outlets the bot READS for facts. It crawls the public home page and the listed news sections,
  // opens the article pages, then writes an original text with source links.
  "Sources": [
    { "Name": "Koha",          "HomeUrl": "https://www.koha.net/",          "MaxArticlePages": 24 },
    { "Name": "Insajderi",     "HomeUrl": "https://insajderi.com/",         "MaxArticlePages": 24 },
    { "Name": "Sinjali",       "HomeUrl": "https://sinjali.com/",           "CategoryUrls": ["https://sinjali.com/category/lajme/"], "MaxArticlePages": 24 },
    { "Name": "Telegrafi",     "HomeUrl": "https://telegrafi.com/",         "CategoryUrls": ["https://telegrafi.com/category/lajme/"], "MaxArticlePages": 24 },
    { "Name": "Kallxo",        "HomeUrl": "https://kallxo.com/",            "CategoryUrls": ["https://kallxo.com/lajme/"], "MaxArticlePages": 24 },
    { "Name": "Gazeta Express","HomeUrl": "https://www.gazetaexpress.com/", "MaxArticlePages": 24 },
    { "Name": "Nacionale",     "HomeUrl": "https://nacionale.com/",         "CategoryUrls": ["https://nacionale.com/politike"], "MaxArticlePages": 24 },
    { "Name": "RTK",           "HomeUrl": "https://www.rtklive.com/sq/",    "MaxArticlePages": 24 },
    { "Name": "Evropa e Lirë", "HomeUrl": "https://www.evropaelire.org/",   "MaxArticlePages": 24 }
  ],

  // Your own domains: never used as a news source (your site slugs/names are excluded automatically as well).
  "OwnDomains": [],

  // Your sites. "Repo" is used by the GitHub workflow to check them out into sites/<Slug>.
  "Sites": [
    {
      "Slug": "raporti-sot",
      "Name": "Raporti Sot",
      "Repo": "bg20033/raporti-sot",
      "Branch": "main",
      "Accent": "#cc0000",
      "MaxArticlesPerRun": 2,
      "AuthorId": "redaksia",
      "AuthorName": "Redaksia e Raporti Sot",
      "Style": "Analytical and explanatory. Put the news in context: what happened, why it matters, what comes next. Calm, measured sentences."
    },
    {
      "Slug": "infokosove24",
      "Name": "InfoKosove24",
      "Repo": "bg20033/infokosove24",
      "Branch": "main",
      "Accent": "#0057b8",
      "Tint": "#081e48",
      "TintAmount": 0.35,
      "MaxArticlesPerRun": 2,
      "AuthorId": "redaksia",
      "AuthorName": "Redaksia e InfoKosove24",
      "Style": "Fast, clear news service. Short paragraphs of 2–3 sentences, the most important facts first, plain everyday language. Good for readers on mobile."
    },
    {
      "Slug": "kosova-aktuale",
      "Name": "Kosova Aktuale",
      "Repo": "bg20033/kosova-aktuale",
      "Branch": "main",
      "Accent": "#0a7d4f",
      "Tint": "#0c3424",
      "TintAmount": 0.3,
      "MaxArticlesPerRun": 2,
      "AuthorId": "redaksia",
      "AuthorName": "Redaksia e Kosova Aktuale",
      "Style": "Feature-style reporting: open with a concrete scene or detail from the sources, then explain the background and the people or institutions involved. Warm but neutral."
    },
    {
      "Slug": "kosova-fakt",
      "Name": "Kosova Fakt",
      "Repo": "bg20033/kosova-fakt",
      "Branch": "main",
      "Accent": "#f5b400",
      "Tint": "#121214",
      "TintAmount": 0.5,
      "MaxArticlesPerRun": 2,
      "AuthorId": "redaksia",
      "AuthorName": "Redaksia e Kosova Fakt",
      "Style": "Fact-first. After the opening paragraph add a section '## Faktet kryesore' with 4–6 bullet points of verified facts from the sources, then explanation. Be explicit about what is confirmed and what is still unclear."
    }
  ]
}
